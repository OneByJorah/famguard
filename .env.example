# famguard — Environment Configuration
# Copy to .env and fill in. NEVER commit the real .env.

# --- Cloudflare Tunnel ---
# Create a tunnel in the Cloudflare Zero Trust dashboard (Networks > Tunnels),
# point your hostname (e.g. dns.example.com) at:
#   http://adguard:3000   (DNS-over-HTTPS + enrollment portal routes)
# then paste the tunnel token here:
TUNNEL_TOKEN=<set-your-tunnel-token>

# --- Public hostnames (must match your Cloudflare tunnel config) ---
DOH_URL=https://dns.example.com/dns-query
PRIVATE_DNS_HOST=dns.example.com
PORTAL_URL=https://dns.example.com

# --- Portal ---
PORTAL_PORT=8080
